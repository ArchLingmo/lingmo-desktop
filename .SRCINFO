pkgbase = lingmo-desktop
	pkgdesc = Lingmo desktop environment (Qt 6): session, shell, apps, themes and login screen
	pkgver = 1.3.0
	pkgrel = 1
	url = https://github.com/ArchLingmo/lingmo-desktop
	arch = any
	license = GPL-3.0-or-later
	depends = LingmoUI
	depends = liblingmo
	depends = lingmo-qt-plugins
	depends = lingmo-core
	depends = lingmo-statusbar
	depends = lingmo-dock
	depends = lingmo-launcher
	depends = lingmo-filemanager
	depends = lingmo-settings
	depends = lingmo-spotlight
	depends = lingmo-kwin-plugins
	depends = lingmo-systemicons
	depends = lingmo-artwork
	depends = lingmo-wallpapers
	depends = lingmo-cursor-themes
	depends = lingmo-gtk-themes
	depends = lingmo-sddm-theme
	depends = sddm
	depends = xorg-server
	depends = lingmo-terminal
	depends = lingmo-texteditor
	depends = lingmo-calculator
	depends = lingmo-screenshots
	depends = lingmo-screenlocker
	depends = lingmo-videoplayer
	depends = lingmo-updater
	optdepends = konsole: KDE terminal
	optdepends = flameshot: screenshots (bind it to Print in Settings > Shortcuts)
	optdepends = networkmanager: network and VPN in the status bar
	optdepends = bluez: Bluetooth settings

pkgname = lingmo-desktop
